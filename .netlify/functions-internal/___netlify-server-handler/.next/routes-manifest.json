{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/connections/[id]",
      "regex": "^/api/connections/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/connections/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/connections/[id]/metadata",
      "regex": "^/api/connections/([^/]+?)/metadata(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/connections/(?<nxtPid>[^/]+?)/metadata(?:/)?$"
    },
    {
      "page": "/api/connections/[id]/test",
      "regex": "^/api/connections/([^/]+?)/test(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/connections/(?<nxtPid>[^/]+?)/test(?:/)?$"
    },
    {
      "page": "/api/queries/[id]",
      "regex": "^/api/queries/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/queries/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/auth/session",
      "regex": "^/api/auth/session(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/session(?:/)?$"
    },
    {
      "page": "/api/auth/signin",
      "regex": "^/api/auth/signin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/signin(?:/)?$"
    },
    {
      "page": "/api/auth/signout",
      "regex": "^/api/auth/signout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/signout(?:/)?$"
    },
    {
      "page": "/api/auth/signup",
      "regex": "^/api/auth/signup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/signup(?:/)?$"
    },
    {
      "page": "/api/connections",
      "regex": "^/api/connections(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/connections(?:/)?$"
    },
    {
      "page": "/api/connections/test",
      "regex": "^/api/connections/test(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/connections/test(?:/)?$"
    },
    {
      "page": "/api/health",
      "regex": "^/api/health(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/health(?:/)?$"
    },
    {
      "page": "/api/history",
      "regex": "^/api/history(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/history(?:/)?$"
    },
    {
      "page": "/api/queries",
      "regex": "^/api/queries(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/queries(?:/)?$"
    },
    {
      "page": "/api/query/execute",
      "regex": "^/api/query/execute(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/query/execute(?:/)?$"
    },
    {
      "page": "/api/query/paginate",
      "regex": "^/api/query/paginate(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/query/paginate(?:/)?$"
    },
    {
      "page": "/apple-icon.png",
      "regex": "^/apple\\-icon\\.png(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/apple\\-icon\\.png(?:/)?$"
    },
    {
      "page": "/icon.png",
      "regex": "^/icon\\.png(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.png(?:/)?$"
    },
    {
      "page": "/signin",
      "regex": "^/signin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/signin(?:/)?$"
    },
    {
      "page": "/signup",
      "regex": "^/signup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/signup(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}